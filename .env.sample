# Copy to .env and adjust as needed. All app config values below have safe local
# defaults (see src/config.js) so the service runs without a .env file at all;
# this file documents every variable explicitly for local development.

# --- Server ---
HOST=0.0.0.0
PORT=3001
SERVICE_VERSION=

# --- CDP environment ---
# One of: local, infra-dev, management, dev, test, perf-test, ext-test, prod
ENVIRONMENT=local

# --- Logging ---
LOG_ENABLED=true
LOG_LEVEL=info
LOG_FORMAT=pino-pretty

# --- HTTP proxy (optional) ---
HTTP_PROXY=

# --- CDP tracing ---
TRACING_HEADER=x-cdp-request-id

# --- AWS / S3-compatible storage ---
AWS_REGION=eu-west-2
AWS_ENDPOINT_URL=http://localhost:4566
S3_FORCE_PATH_STYLE=true
# Consumed directly by the AWS SDK (not app config). Use dummy local values with
# Floci; must be provided by the platform IAM role in deployed environments.
AWS_ACCESS_KEY_ID=required
AWS_SECRET_ACCESS_KEY=required

# --- Reference data storage / cache lifecycle ---
REFERENCE_DATA_BUCKET=mmo-cr-reference-data-service
REFERENCE_DATA_REFRESH_INTERVAL_MS=60000
REFERENCE_DATA_MAX_UPLOAD_BYTES=26214400
REFERENCE_DATA_REFRESH_ENABLED=true
REFERENCE_DATA_REFRESH_INITIAL_DELAY_MS=0
REFERENCE_DATA_HYDRATION_TIMEOUT_MS=10000
REFERENCE_DATA_REFRESH_CONCURRENCY=3
REFERENCE_DATA_MANDATORY_DATASETS=vessels,gears,ports,species,map-land,map-statistical-areas
REFERENCE_DATA_AUTO_START_CACHE_REFRESH=true

# --- Health ---
HEALTH_DEPENDENCY_PROBE_TIMEOUT_MS=2000

# --- Observability ---
METRICS_ENABLED=true
AUDIT_ENABLED=true

# --- Authentication Service (not yet implemented) ---
AUTHENTICATION_SERVICE_URL=
AUTHENTICATION_SERVICE_TIMEOUT_MS=2000
AUTHENTICATION_SERVICE_RETRY_COUNT=1
AUTHENTICATION_SERVICE_RETRY_DELAY_MS=100
